nmap -v 192.168.0.0/24  #comando que busca informações dos dispositivos das redes
nmap -v -sn 192.168.212.50-100  #varre as portas do ip 50 até o 100
namp -v -sn 192.168.50.100-200 | grep 192 # varre a rede mostrando menos informações
namp 10.10.20.122    #informar as portas e serviço deste host  p
