nmap -v -sU 192.168.15.70-220 -p 21,22,23,8080   #escanea as portas especificadas 



#  NMAP SCRIPT ENGINE 
#O Nmap Scripting Engine (NSE) é um dos recursos mais poderosos e flexíveis do Nmap, permitindo que os 
#usuários utilizem scripts para automatizar uma ampla variedade de tarefas de rede.

# Para usar o NMAP SCRIPT ENGINE é necessário entrar na pasta de script do nmap no Kali Linux
cd /usr/share/nmap/scripts     #acesso a pasta de scripts, nessa pasta há scripts para achar 
# vulnerabilidades em roteadores de marcas específicas entre outros  
nmap --scripthelp http-dlink-backdoor.nse  # informar o que script pode fazer e como usa-lo
nmap 192.168.15.0/24 -p 25 --script banner.nse  # será realizado uma varredura na rede, na porta 25 (smtp)
# usando o script banner 
nmap --script=nfs-ls 192.168.0.18  # faz a varredura das portas e informa se há compartilhamento
# de volume e tipos de arquivos (nfs porta 2049, compartilhamento de arquivo) 
namp --script ftp-vsftpd-backdoor.nse --script-args ftp-vsftpd-backdoor.cmd="ls" 192.168.212.21  #informar
#as portas abertas, mostra as vulberabilidades e o argumento ls mostra os arquivos na pasta.


# Enumeração com nmap
#A enumeração é um processo que estabelece uma conexão ativa com os hosts de destino para descobrir 
possíveis vetores de ataque, podendo ser usado para exploração do sistema. Alguns dos comandos abaixo podem 
ser identificados e barrados pelo Firewall, obtenha permissão para executá-lo.

sudo nmap -v -T5 -sS -Pn --open 192.168.0.1/24   #comando que realiza uma varredura de rede rápida e 
#silenciosa para identificar portas abertas em todos os dispositivos conectados à rede local
sudo nmap -O 192.168.0.1  #varre o host e informa o sistena operacional
sudo nmap -A 192.168.0.106  #varre e informa as versões dos serviços
sudo nmap -v -sS -sV -T5 -p 22 192.168.0.1   #saber o serviço rodando na porta 22 ssh bem como outras informações
sudo nmap -v -sS -sV -T5 -p 21-445 192.168.0 106  #saber o serviço rodando entre as portas 21 ate 445
sudo nmap -sV -p 21,22,80,445,139, 192.168.20.96 # realiza o scan das portas especificadas e as
# versões dos serviços que estão em operação em caso de open use ftp 192.168.20.96 para
# se conectar, será necessário descobrir usuário e senha para sair digite quit



